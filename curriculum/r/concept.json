    {
      "id": "c-04-observer",
      "track": "concept",
      "title": "Observers are not the data path",
      "goal": "Add an observer that watches x but does not feed an output.",
      "body": "Observers run for side effects: logs, writes, notifications.\nThey are not cached values. Never wire an observer as the source of an output.",
      "hint": "node observer log — edge x→log only. No edge into out from log.",
      "par": 2,
      "startGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
          { "id": "out", "kind": "output", "label": "out" }
        ],
        "edges": [{ "from": "x", "to": "out" }]
      },
      "targetGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
          { "id": "out", "kind": "output", "label": "out" },
          { "id": "log", "kind": "observer", "label": "log" }
        ],
        "edges": [
          { "from": "x", "to": "out" },
          { "from": "x", "to": "log" }
        ]
      },
      "starterCode": "",
      "checks": [
        {
          "type": "graphMatch",
          "value": {
            "nodes": [{ "id": "log", "kind": "observer" }],
            "edges": [{ "from": "x", "to": "log" }]
          }
        },
        { "type": "graphNoEdge", "value": { "from": "log", "to": "out" } }
      ],
      "solution": "node observer log\nedge x log",
      "sample": "observe({\n  message(\"x is now \", input$x)\n})"
    },
    {
      "id": "c-05-isolate",
      "track": "concept",
      "title": "Break a dependency with isolate",
      "goal": "Keep x→out, but read a value from n without taking a dependency on n.",
      "body": "reactiveVal n feeds observer clear.\nIf out also reads n, out would re-run every time n changes.\nUse isolate so out only re-runs when x changes.",
      "hint": "Edge n→clear and n→iso, but do NOT edge n→out. iso is a reactive marked as isolated read.",
      "par": 4,
      "startGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
          { "id": "n", "kind": "input", "label": "n" },
          { "id": "out", "kind": "output", "label": "out" },
          { "id": "clear", "kind": "observer", "label": "clear" }
        ],
        "edges": [
          { "from": "x", "to": "out" },
          { "from": "n", "to": "clear" }
        ]
      },
      "targetGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
          { "id": "n", "kind": "input", "label": "n" },
          { "id": "out", "kind": "output", "label": "out" },
          { "id": "clear", "kind": "observer", "label": "clear" },
          { "id": "iso", "kind": "reactive", "label": "iso" }
        ],
        "edges": [
          { "from": "x", "to": "out" },
          { "from": "iso", "to": "out" },
          { "from": "n", "to": "clear" },
          { "from": "n", "to": "iso" }
        ]
      },
      "starterCode": "",
      "checks": [
        {
          "type": "graphMatch",
          "value": {
            "nodes": [{ "id": "iso", "kind": "reactive" }],
            "edges": [
              { "from": "n", "to": "iso" },
              { "from": "iso", "to": "out" }
            ]
          }
        },
        { "type": "graphNoEdge", "value": { "from": "n", "to": "out" } }
      ],
      "solution": "node reactive iso\nedge n iso\nedge iso out",
      "sample": "output$out <- renderText({\n  paste(input$x, \"/\", isolate(input$n()))\n})"
    }
  ]
