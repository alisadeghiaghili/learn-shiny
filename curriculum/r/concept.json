  "levels": [
    {
      "id": "c-01-two-halves",
      "track": "concept",
      "title": "Two halves",
      "goal": "Build a graph with one input and one output, wired through server.",
      "body": "A Shiny app has two halves.\nUI declares widgets and placeholders. Server fills those placeholders from data.\nNothing is magic: every output is computed from inputs and reactives.",
      "hint": "Add an input node named x, an output node named out, then connect them.",
      "par": 3,
      "startGraph": { "nodes": [], "edges": [] },
      "targetGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
          { "id": "out", "kind": "output", "label": "out" }
        ],
        "edges": [{ "from": "x", "to": "out" }]
      },
      "starterCode": "",
      "checks": [
        {
          "type": "graphMatch",
          "value": {
            "nodes": [
              { "id": "x", "kind": "input" },
              { "id": "out", "kind": "output" }
            ],
            "edges": [{ "from": "x", "to": "out" }]
          }
        }
      ],
      "solution": "node input x\nnode output out\nedge x out",
      "sample": "library(shiny)\n\nui <- fluidPage(\n  sliderInput(\"x\", \"X\", 0, 10, 1),\n  textOutput(\"out\")\n)\n\nserver <- function(input, output, session) {\n  output$out <- renderText({\n    paste(\"x is\", input$x)\n  })\n}\n\nshinyApp(ui, server)"
    },
    {
      "id": "c-02-reactive-pipe",
      "track": "concept",
      "title": "The reactive pipe",
      "goal": "Insert a reactive between input and output.",
      "body": "Outputs should stay thin. Put shared math in a reactive expression.\nIt recomputes only when its dependencies change, then feeds every consumer.",
      "hint": "node reactive y — then edge x→y and y→out.",
      "par": 5,
      "startGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
          { "id": "out", "kind": "output", "label": "out" }
        ],
        "edges": [{ "from": "x", "to": "out" }]
      },
      "targetGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
          { "id": "y", "kind": "reactive", "label": "y" },
          { "id": "out", "kind": "output", "label": "out" }
        ],
        "edges": [
          { "from": "x", "to": "y" },
          { "from": "y", "to": "out" }
        ]
      },
      "starterCode": "",
      "checks": [
        {
          "type": "graphMatch",
          "value": {
            "nodes": [
              { "id": "x", "kind": "input" },
              { "id": "y", "kind": "reactive" },
              { "id": "out", "kind": "output" }
            ],
            "edges": [
              { "from": "x", "to": "y" },
              { "from": "y", "to": "out" }
            ]
          }
        }
      ],
      "solution": "edge-del x out\nnode reactive y\nedge x y\nedge y out",
      "sample": "y <- reactive({\n  input$x * 2\n})\n\noutput$out <- renderText({\n  paste(\"y is\", y())\n})"
    },
    {
      "id": "c-03-two-consumers",
      "track": "concept",
      "title": "One reactive, many consumers",
      "goal": "Fan one reactive into two outputs without duplicating the math.",
      "body": "When two outputs need the same value, do not copy the formula.\nOne reactive, two edges out. Invalidation stays automatic.",
      "hint": "Keep y. Add out2 and edge y→out2.",
      "par": 3,
      "startGraph": {
        "nodes": [
          { "id": "x", "kind": "input", "label": "x" },
